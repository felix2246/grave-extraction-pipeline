{
    "shared_context": {
        "structured": {
          "fundort": "Jablonec I", // wir finden jetzt genauere Spezifikation des Fundortes im Titel
          "bestattung_ritus": "körperbestattung", //"acht Körpergräber"
		  "bestattung_störung": null, // Gräber waren gestört, aber von Störung der Bestattungen keine Info
          "grube_tiefe": "60", // "in einer Tiefe von 50 – 60 cm", entscheide dich für einen möglichen Wert
        },
        "interpretive": []
    },
    "graves": [] // keine Gräber extrahiert, da hier nur Gräber erwähnt werden aber nicht explizit eigens beschrieben
}
